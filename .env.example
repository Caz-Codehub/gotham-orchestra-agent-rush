# Manual configuration. Default is ZERO paid cloud calls.
GOTHAM_INFERENCE_PROVIDER=none
# For local, free inference, install Ollama and change to ollama:
# GOTHAM_INFERENCE_PROVIDER=ollama
GOTHAM_OLLAMA_MODEL=qwen2.5:1.5b
# Local-only model. Cloud aliases ending -cloud or :cloud are rejected.
# Ollama cloud features can also be disabled independently in server.json.
GOTHAM_MAX_MODEL_CALLS=16
# Laptop defaults: at most one local completion, 4K context, model unloads after idle.
GOTHAM_LOCAL_CONTEXT_TOKENS=4096
GOTHAM_LOCAL_REQUEST_TIMEOUT_SECONDS=90
GOTHAM_LOCAL_KEEP_ALIVE=30s
GOTHAM_ACCESS_TOKEN=generate-a-unique-strong-secret-locally
GOTHAM_BATMAN_TOKEN=generate-a-DIFFERENT-unique-secret-locally
GOTHAM_SANDBOX_IMAGE=python:3.12-alpine
GOTHAM_SPECTER_STALE_SECONDS=90
# Optional local-only Specter incident assessment. Defaults off:
# GOTHAM_SPECTER_LOCAL_AI=1
# Optional HTTPS-only endpoint, set only with Batman's permission:
# GOTHAM_BATMAN_ALERT_WEBHOOK=https://YOUR-PRIVATE-ALERT-ENDPOINT
# Cloud inference requires deliberate TWO-STEP opt-in with potential charges:
# GOTHAM_INFERENCE_PROVIDER=vultr
# GOTHAM_ALLOW_PAID_INFERENCE=I_ACCEPT_POTENTIAL_CHARGES
# VULTR_INFERENCE_API_KEY=your-private-key
# VULTR_INFERENCE_MODEL=verified-model-id
