[Unit]
Description=Gotham 4.0 API
After=network-online.target docker.service
[Service]
User=gotham
Group=gotham
WorkingDirectory=/opt/gotham/current
EnvironmentFile=/etc/gotham/gotham.env
ExecStart=/opt/gotham/venv/bin/uvicorn gotham.app:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/gotham /var/lib/gotham-audit
PrivateTmp=true
[Install]
WantedBy=multi-user.target
